rules_version = '2';

// Paste this into: Firebase console > Build > Firestore Database > Rules tab > Publish
//
// Any signed-in user (i.e. anyone you've added under Authentication > Users)
// can read and write every estimate. That matches an internal shared tool —
// everyone on the team can see and edit everyone else's estimates. If you
// later want to restrict editing to the estimate's own author, or add an
// admin-only role, that logic goes here.

service cloud.firestore {
  match /databases/{database}/documents {

    match /estimates/{estimateId} {
      allow read, write: if request.auth != null;
    }

    match /counters/{counterId} {
      allow read, write: if request.auth != null;
    }

    // One offer document per estimate revision (document id = the estimate's id).
    match /offers/{offerId} {
      allow read, write: if request.auth != null;
    }

    // Shared standard settings, e.g. settings/offerDefaults (standard terms, signatory).
    match /settings/{settingId} {
      allow read, write: if request.auth != null;
    }

  }
}
